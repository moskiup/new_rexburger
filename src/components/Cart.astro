---
import { site } from '../data/config';
---

<button type="button" class="fab" id="cart-open" aria-label="Abrir carrito">
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" /><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 7H6" /></svg>
  <span class="count" id="cart-count" hidden>0</span>
</button>

<dialog id="add-modal" class="modal wide">
  <form method="dialog" class="box" id="add-form" tabindex="-1" autofocus>
    <div class="pic"><img id="add-img" alt="" /></div>
    <div class="datos">
      <button type="button" class="x" data-close aria-label="Cerrar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
      <p class="nombre-producto" id="add-name"></p>
      <fieldset>
        <legend>Talla</legend>
        <div class="sizes" id="add-sizes"></div>
      </fieldset>
      <div class="qty">
        <button type="button" id="q-minus" aria-label="Menos">−</button>
        <output id="q-val">1</output>
        <button type="button" id="q-plus" aria-label="Más">+</button>
      </div>
      <button type="submit" class="primary">Agregar al carrito</button>
    </div>
  </form>
</dialog>

<dialog id="cart-modal" class="modal side" data-wa={site.whatsappPedidos}>
  <div class="box" tabindex="-1" autofocus>
    <button type="button" class="x" data-close aria-label="Cerrar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
    <h2>Tu pedido</h2>
    <ul id="cart-list"></ul>
    <p class="empty" id="cart-empty">Aún no agregas nada.</p>
    <p class="total" id="cart-total" hidden></p>
    <button type="button" class="primary" id="checkout" disabled>Enviar pedido por WhatsApp</button>
    <button type="button" class="link" id="cart-clear" hidden>Vaciar carrito</button>
  </div>
</dialog>

<style is:global>
  .fab {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 50;
    width: 58px; height: 58px; border-radius: 50%; border: 0;
    background: var(--red); color: #fff; display: grid; place-items: center; cursor: pointer;
    box-shadow: 0 8px 22px rgb(0 0 0 / .3); transition: transform .25s ease;
  }
  @media (hover: hover) { .fab:hover { transform: scale(1.1); } }
  .fab:active { transform: scale(.94); }
  /* El botón flotante no debe tapar el contenido final del pie de página. */
  body:has(.fab) footer { padding-bottom: calc(92px + env(safe-area-inset-bottom)); }
  .fab .count[hidden] { display: none; }
  .fab.bump { animation: bump .45s ease; }
  @keyframes bump { 30% { transform: scale(1.3); } 60% { transform: scale(.95); } }
  .fab .count {
    position: absolute; top: -4px; right: -4px; min-width: 22px; height: 22px; padding: 0 5px;
    border-radius: 11px; background: var(--yellow); color: var(--red); font-size: var(--fs-xs); font-weight: 700;
    display: grid; place-items: center;
  }
  .modal { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100dvh; color: var(--red); overflow: visible; }
  .modal::backdrop { background: rgb(0 0 0 / .55); backdrop-filter: blur(2px); }
  .modal[open] { animation: modal-in .3s cubic-bezier(.2, .7, .2, 1); }
  @keyframes modal-in { from { opacity: 0; transform: translateY(24px) scale(.96); } }
  .modal .box:focus { outline: none; }
  html:has(dialog[open]) { overflow: hidden; }
  .modal .box {
    position: relative; background: #fff; border-radius: 24px; padding: 22px;
    width: min(92vw, 420px); max-height: 90dvh; overflow-x: hidden; overflow-y: auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin: 0;
  }
  .modal.wide .box { width: min(94vw, 780px); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: center; padding: 24px; }
  .modal.wide .datos { display: grid; gap: 18px; align-content: center; justify-items: center; text-align: center; }
  .modal.wide .sizes { justify-content: center; }
  .modal.wide .datos .primary { width: 100%; }
  .modal.wide .x { top: 24px; right: 24px; width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--red); display: grid; place-items: center; padding: 0; transition: background .2s, color .2s; }
  .modal.wide .x:hover { background: var(--red); color: #fff; }
  @media (max-width: 767px) {
    .modal.wide .box { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    /* Hoja inferior: más natural para el pulgar. */
    .modal.wide { margin: auto auto 0; width: min(100%, 560px); max-width: 100%; }
    .modal.wide .box {
      width: 100%;
      max-height: 92dvh;
      border-radius: 24px 24px 0 0;
      padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    }
    .modal.wide .pic { position: relative; aspect-ratio: 1.75 / 1; padding: 0; overflow: hidden; }
    .modal.wide .pic img { position: absolute; inset: 4%; width: 92%; height: 92%; }
    .modal.wide .datos { gap: 12px; padding-top: 0; }
    .modal.wide .x { top: 16px; right: 16px; width: var(--tap); height: var(--tap); background: #fff; z-index: 2; }
    .modal.wide[open] { animation: sheet-in .35s cubic-bezier(.2, .7, .2, 1); }
    .modal.side .box { border-radius: 0; padding-bottom: calc(22px + env(safe-area-inset-bottom)); }
    .modal .x { width: var(--tap); height: var(--tap); }
  }
  @keyframes sheet-in { from { transform: translateY(100%); } }
  .modal .x { position: absolute; top: 10px; right: 14px; border: 0; background: none; color: var(--red); display: grid; place-items: center; width: 34px; height: 34px; padding: 0; cursor: pointer; z-index: 1; }
  .modal .pic { background: var(--cream); border-radius: 18px; aspect-ratio: 1 / 1; display: grid; place-items: center; padding: 6%; }
  .modal .pic { min-width: 0; }
  .modal .pic img { width: 100%; height: 100%; max-width: 100%; object-fit: contain; }
  .modal h2, .modal .nombre-producto { font-size: var(--fs-lg); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .modal fieldset { border: 0; padding: 0; margin: 0; }
  .modal legend { font-size: var(--fs-xs); letter-spacing: .15em; text-transform: uppercase; margin-bottom: 8px; color: #6b6b6b; padding: 0; }
  .sizes { display: flex; flex-wrap: wrap; gap: 8px; }
  .sizes label { cursor: pointer; position: relative; }
  .sizes input { position: absolute; opacity: 0; pointer-events: none; }
  .sizes span { display: grid; place-items: center; min-height: var(--tap); min-width: 52px; padding: 0 18px; border: 2px solid var(--red); border-radius: 999px; font-weight: 600; font-size: var(--fs-sm); letter-spacing: .08em; transition: background .2s, color .2s; }
  .sizes input:checked + span { background: var(--red); color: #fff; }
  .sizes input:focus-visible + span { outline: 2px solid var(--yellow); outline-offset: 2px; }
  .qty { display: flex; align-items: center; justify-content: center; gap: 18px; }
  .qty button, .line .q button { width: var(--tap); height: var(--tap); border-radius: 50%; border: 2px solid var(--red); background: none; color: var(--red); font-size: var(--fs-xl); cursor: pointer; line-height: 1; }
  .qty output { min-width: 32px; text-align: center; font-size: var(--fs-xl); font-weight: 600; }
  .primary { border: 0; border-radius: 999px; background: var(--orange); color: var(--on-orange); min-height: 52px; padding: 14px 20px; font: 700 14px var(--font-body); letter-spacing: .1em; text-transform: uppercase; cursor: pointer; transition: transform .2s, filter .2s; }
  .primary:hover:not(:disabled) { transform: scale(1.03); filter: brightness(1.06); }
  .primary:disabled { opacity: .45; cursor: not-allowed; }
  .link { border: 0; background: none; color: var(--red); text-decoration: underline; cursor: pointer; font: 500 13px var(--font-body); }
  .modal.side { margin-left: auto; margin-right: 0; height: 100dvh; }
  .modal.side .box { height: 100dvh; max-height: 100dvh; border-radius: 24px 0 0 24px; width: min(100vw, 420px); align-content: start; grid-template-rows: auto auto 1fr auto auto auto; }
  .modal.side[open] { animation: side-in .35s cubic-bezier(.2, .7, .2, 1); }
  @keyframes side-in { from { transform: translateX(100%); } }
  #cart-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; align-content: start; overflow: auto; }
  .line { display: grid; grid-template-columns: 64px 1fr auto; gap: 12px; align-items: center; }
  .line img { width: 64px; height: 64px; object-fit: contain; background: var(--cream); border-radius: 12px; }
  .line strong { display: block; font-size: var(--fs-sm); letter-spacing: .08em; text-transform: uppercase; }
  .line small { color: #6b6b6b; }
  .line .q { display: flex; align-items: center; gap: 8px; }
  .line .q button { width: 40px; height: 40px; font-size: var(--fs-lg); }
  .empty { color: #6b6b6b; text-align: center; margin: 24px 0; }
  .total { font-weight: 600; text-align: right; }
  @media (prefers-reduced-motion: reduce) { .modal[open], .fab.bump { animation: none; } }
</style>

<script>
  type Line = { nombre: string; talla: string; qty: number; img: string };
  const KEY = 'rex-carrito';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const addModal = $<HTMLDialogElement>('add-modal');
  const cartModal = $<HTMLDialogElement>('cart-modal');
  const fab = $<HTMLButtonElement>('cart-open');
  let cart: Line[] = [];
  try { cart = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { cart = []; }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(cart)); } catch {} };
  const pieces = () => cart.reduce((n, l) => n + l.qty, 0);

  function render() {
    const count = $('cart-count');
    count.textContent = String(pieces());
    count.hidden = pieces() === 0;
    const list = $('cart-list');
    list.replaceChildren(
      ...cart.map((l, i) => {
        const li = document.createElement('li');
        li.className = 'line';
        const img = document.createElement('img');
        img.src = l.img; img.alt = '';
        const info = document.createElement('div');
        const name = document.createElement('strong'); name.textContent = l.nombre;
        const talla = document.createElement('small'); talla.textContent = `Talla: ${l.talla}`;
        info.append(name, talla);
        const q = document.createElement('div');
        q.className = 'q';
        const minus = document.createElement('button'); minus.type = 'button'; minus.textContent = '−'; minus.setAttribute('aria-label', 'Menos');
        const n = document.createElement('span'); n.textContent = String(l.qty);
        const plus = document.createElement('button'); plus.type = 'button'; plus.textContent = '+'; plus.setAttribute('aria-label', 'Más');
        minus.onclick = () => { l.qty -= 1; if (l.qty <= 0) cart.splice(i, 1); save(); render(); };
        plus.onclick = () => { l.qty += 1; save(); render(); };
        q.append(minus, n, plus);
        li.append(img, info, q);
        return li;
      }),
    );
    $('cart-empty').hidden = cart.length > 0;
    const total = $('cart-total');
    total.hidden = cart.length === 0;
    total.textContent = `Total de piezas: ${pieces()}`;
    $<HTMLButtonElement>('checkout').disabled = cart.length === 0;
    $('cart-clear').hidden = cart.length === 0;
  }

  // Elegir producto
  let current: { nombre: string; img: string } | null = null;
  let qty = 1;
  const setQty = (n: number) => { qty = Math.max(1, Math.min(20, n)); $('q-val').textContent = String(qty); };
  document.querySelectorAll<HTMLElement>('[data-producto]').forEach((card) => {
    card.addEventListener('click', () => {
      const img = card.querySelector<HTMLImageElement>('.prod')!;
      current = { nombre: card.dataset.nombre!, img: img.currentSrc || img.src };
      $<HTMLImageElement>('add-img').src = current.img;
      $<HTMLImageElement>('add-img').alt = current.nombre;
      $('add-name').textContent = current.nombre;
      $('add-sizes').replaceChildren(
        ...card.dataset.tallas!.split(',').map((t, i) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          input.type = 'radio'; input.name = 'talla'; input.value = t; input.checked = i === 0;
          const span = document.createElement('span'); span.textContent = t;
          label.append(input, span);
          return label;
        }),
      );
      setQty(1);
      addModal.showModal();
    });
  });
  $('q-minus').onclick = () => setQty(qty - 1);
  $('q-plus').onclick = () => setQty(qty + 1);
  $('add-form').addEventListener('submit', () => {
    if (!current) return;
    const talla = document.querySelector<HTMLInputElement>('#add-sizes input:checked')?.value ?? '';
    const found = cart.find((l) => l.nombre === current!.nombre && l.talla === talla);
    if (found) found.qty += qty;
    else cart.push({ nombre: current.nombre, talla, qty, img: current.img });
    save(); render();
    fab.classList.remove('bump'); void fab.offsetWidth; fab.classList.add('bump');
  });

  // Cerrar modales (botón × y clic en el fondo)
  [addModal, cartModal].forEach((d) => {
    d.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => d.close()));
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
  fab.addEventListener('click', () => cartModal.showModal());
  $('cart-clear').addEventListener('click', () => { cart = []; save(); render(); });

  // Checkout: abre WhatsApp con el pedido completo
  $('checkout').addEventListener('click', () => {
    if (!cart.length) return;
    const lines = cart.map((l) => `• ${l.qty} x ${l.nombre} (Talla ${l.talla})`);
    const msg = ['¡Hola Rex Burger! Quiero hacer el siguiente pedido de merch:', '', ...lines, '', `Total de piezas: ${pieces()}`].join('\n');
    window.open(`https://wa.me/${cartModal.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });

  render();
</script>
