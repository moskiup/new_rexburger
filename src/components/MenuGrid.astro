---
import { Image } from 'astro:assets';
import cuadrosIzq from '../assets/inicio/menu-cuadros-izquierda.png';
import cuadrosDer from '../assets/inicio/menu-cuadros-derecha.png';
import hamburguesas from '../assets/inicio/hamburguesas.webp';
import combos from '../assets/inicio/combos.webp';
import complementos from '../assets/inicio/complementos.webp';
import bebidas from '../assets/inicio/bebidas.webp';
import postres from '../assets/inicio/postres-malteadas.webp';
import cajita from '../assets/inicio/cajita-rexy-kids.webp';

/* Posiciones en coordenadas de la referencia (1000px de ancho, sección de 689px): centro horizontal del icono, borde inferior común de cada fila (by) y centro de la etiqueta. Cada icono conserva su escala (w = ancho). Iconos y etiquetas quedan alineados hacia abajo. */
const items = [
  { label: 'Hamburguesas', href: '/menu#hamburguesas', img: hamburguesas, cx: 200, w: 175, by: 912, lx: 200, ly: 948 },
  { label: 'Combos', href: '/menu#combos', img: combos, cx: 505, w: 160, by: 912, lx: 505, ly: 948 },
  { label: 'Complementos', href: '/menu#complementos', img: complementos, cx: 785, w: 130, by: 912, lx: 788, ly: 948 },
  { label: 'Bebidas', href: '/menu#bebidas', img: bebidas, cx: 200, w: 101, by: 1134, lx: 200, ly: 1165 },
  { label: 'Postres & Malteadas', href: '/menu#malteadas', img: postres, cx: 505, w: 135, by: 1134, lx: 505, ly: 1165 },
  { label: 'Cajita Rexy Kids', href: '/menu#cajita', img: cajita, cx: 790, w: 190, by: 1134, lx: 788, ly: 1165 },
];
const TOP = 588;
const FONDO = { width: 2400, height: 1654 };
const H = (FONDO.height * 1000) / FONDO.width;
const pct = (v: number) => `${v.toFixed(3)}%`;
const px = (v: number) => pct(v / 10);
const py = (v: number) => pct(((v - TOP) / H) * 100);
---

<section class="menu" aria-labelledby="menu-title" style={`aspect-ratio:${FONDO.width}/${FONDO.height}`}>
  <Image class="cuadros izq" src={cuadrosIzq} alt="" widths={[360, 640, 900]} sizes="36vw" loading="eager" />
  <Image class="cuadros der" src={cuadrosDer} alt="" widths={[360, 640, 900]} sizes="36vw" loading="eager" />
  <h2 id="menu-title">Menú</h2>
  {items.map((it) => (
    <a class="item" href={it.href}>
      <Image class="ico" style={`left:${px(it.cx)};top:${py(it.by)};width:${px(it.w)}`} src={it.img} alt="" widths={[200, 360, 480]} sizes="20vw" />
      <span style={`left:${px(it.lx)};top:${py(it.ly)}`}>{it.label.replace(' & ', ' &\n')}</span>
    </a>
  ))}
</section>

<style>
  .menu { position: relative; container-type: inline-size; overflow: hidden; background: #f0ede2; }
  .cuadros { position: absolute; top: 11.366%; width: 35.542%; height: auto; }
  .izq { left: 0; }
  .der { left: 64.458%; }
  h2 {
    position: absolute;
    left: 50%;
    top: 16.2%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display-light);
    font-weight: 400;
    font-size: 11.5cqw;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ico { position: absolute; height: auto; max-width: none; transform: translate(-50%, -100%); transform-origin: 50% 100%; transition: transform .3s ease, opacity .7s ease, translate .7s cubic-bezier(.2, .7, .2, 1), scale .7s cubic-bezier(.2, .7, .2, 1); }
  @media (hover: hover) and (min-width: 768px) {
    .item:hover .ico, .item:focus-visible .ico { transform: translate(-50%, -100%) scale(1.4); }
  }
  span {
    position: absolute;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 30cqw;
    text-wrap: balance;
    font-size: max(var(--fs-xs), 1.74cqw);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  /* ---------- Móvil: cuadrícula normal (el diseño de escritorio es posicional y deja los iconos diminutos) ---------- */
  @media (max-width: 767px) {
    .menu {
      aspect-ratio: auto !important;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 12px;
      padding: 0 20px 44px;
      align-items: start;
    }
    .cuadros { top: 34px; width: 30%; }
    .der { left: 70%; }
    h2 {
      position: static;
      grid-column: 1 / -1;
      transform: none;
      font-size: 17cqw;
      text-align: center;
      padding: 22px 0 10px;
    }
    .item {
      display: grid;
      justify-items: center;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 10px;
      padding: 6px 0;
      min-height: var(--tap);
    }
    .item .ico {
      position: static !important;
      transform: none !important;
      width: auto !important;
      justify-self: center;
      height: 80px !important;
      max-width: none;
      object-position: 50% 100%;
    }
    .item span {
      position: static !important;
      transform: none !important;
      width: auto;
      max-width: 100%;
      font-size: var(--fs-sm);
      letter-spacing: .05em;
      text-align: center;
      font-weight: 600;
      line-height: 1.25;
      text-wrap: balance;
    }
    .item:active .ico { transform: scale(.94) !important; }
  }
</style>
