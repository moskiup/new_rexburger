---
import { Image } from 'astro:assets';
import camion from '../assets/inicio/camion-rex-burger-eventos.png';
import circulo from '../assets/inicio/circulo-punteado-decorativo-amarillo.webp';
import asterisco from '../assets/inicio/asterisco-decorativo-crema.webp';
import BotonPildora from './BotonPildora.astro';
import { bannerEventos } from '../data/contenido';
import { ciudadesEventos } from '../data/config';

interface Props {
  /** Nivel del título: h1 en la página de eventos, h2 en el inicio. */
  heading?: 'h1' | 'h2';
  ctaLabel?: string;
  ctaHref?: string;
}
const { heading = 'h2', ctaLabel = bannerEventos.boton, ctaHref = '/eventos' } = Astro.props;
const Heading = heading;
---

<section class="eventos" data-anim="deslizar">
  <div class="escena">
  <Image class="pieza circulo" src={circulo} alt="" widths={[200, 400]} sizes="12vw" loading="eager" />
  <Image class="pieza camion" src={camion} alt="Camión de Rex Burger para eventos" widths={[600, 900, 1200, 1600, 2000]} sizes="(max-width: 767px) 70vw, 45vw" quality={85} loading="eager" fetchpriority={heading === 'h1' ? 'high' : undefined} />
  <Image class="pieza asterisco" src={asterisco} alt="" widths={[200, 400]} sizes="12vw" loading="eager" />
  </div>
  <p class="kicker">{bannerEventos.kicker}</p>
  <Heading class="titulo">{bannerEventos.titulo}</Heading>
  <BotonPildora href={ctaHref}>{ctaLabel}{ctaHref === '/eventos' && <span class="sr-only"> sobre nuestros eventos</span>}</BotonPildora>
  <p class="cities">
    {ciudadesEventos.map((c, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">|</span>}
        <span class="ciudad">{c}</span>
      </>
    ))}
  </p>
</section>

<style>
  .eventos {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    background: var(--red);
    aspect-ratio: 2400 / 1344;
  }
  .eventos > :not(.pieza) { position: absolute; margin: 0; }
  /* Piezas sueltas (posiciones sobre el diseño original de 1000 x 560). */
  .pieza { position: absolute; display: block; height: auto; max-width: none; }
  .camion { left: 47.8%; top: 5%; width: 72%; }
  .circulo { left: 57%; top: 9%; width: 11%; animation: spin 16s linear infinite; }
  .asterisco { left: -3.75%; top: 61.7%; width: 11.3%; animation: spin 24s linear infinite reverse; }
  /* Entrada: el camión llega deslizándose desde la derecha (la clase la pone el script, sin JS queda en su sitio). */
  .eventos.slide .camion {
    translate: 115% 0;
    transition: translate 1.6s cubic-bezier(.16, .84, .3, 1), opacity .4s ease;
  }
  .eventos.slide.go .camion { translate: 0 0; }
  .eventos.slide.instant .camion { transition: none; }
  .kicker {
    left: 9.5%; top: 19%;
    color: var(--white);
    font-size: 5.4cqw;
    line-height: 1;
    text-transform: uppercase;
  }
  .titulo {
    left: 9.5%; top: 29.5%;
    font-family: var(--font-display-light);
    font-weight: 400;
    color: var(--yellow);
    font-size: 14.5cqw;
    line-height: 1;
    letter-spacing: .02em;
    text-transform: uppercase;
  }
  /* Posición del botón; su aspecto (píldora con triángulo) está en BotonPildora.astro. */
  .btn { left: 9.5%; width: 33.8%; top: 56%; height: 7.7%; }
  .cities {
    left: 0; right: 0; top: 87%;
    text-align: center;
    color: #fbb500;
    font-size: max(var(--fs-xs), 1.9cqw);
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  /* Ciudades separadas por "|". Cada ciudad es un bloque que no se parte. */
  .cities .ciudad { white-space: nowrap; }
  .cities .sep { margin: 0 .55em; }
  .escena { display: contents; }

  /* ---------- Móvil: se apila (texto, botón y camión) en vez de encoger el banner de escritorio ---------- */
  @media (max-width: 767px) {
    .eventos {
      aspect-ratio: auto;
      display: grid;
      justify-items: start;
      gap: 14px;
      padding: 44px 22px 30px;
    }
    .eventos > :not(.escena) { position: static; margin: 0; }
    .kicker { font-size: 30px; }
    .titulo { font-size: 21cqw; margin-top: -4px; }
    .eventos .btn { justify-self: start; width: min(95%, 237px); height: 44px; margin-top: 10px; font-size: var(--fs-sm); padding-right: 12px; }
    .eventos .btn::after { right: 18px; }
    .eventos > .escena { display: block; position: relative; order: 4; width: calc(100% + 44px); margin: 8px -22px 0; aspect-ratio: 1.25; }
    .escena .pieza { position: absolute; }
    .escena .camion { left: 23.6%; top: 20%; width: 107%; }
    .escena .circulo { left: 34%; top: 15%; width: 24%; }
    .escena .asterisco { left: -6%; top: 66%; width: 20%; }
    /* Móvil: 3 ciudades en la primera línea y 2 en la segunda, separadas por "|". El separador n.º 3 (hijo 6)
       ocupa todo el ancho sin altura: fuerza el salto de línea. */
    .cities { order: 5; width: 100%; padding-top: 10px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; row-gap: 6px; text-align: center; font-size: var(--fs-sm); font-weight: 600; letter-spacing: .1em; line-height: 1.5; }
    .cities .sep { margin: 0 .45em; }
    .cities .sep:nth-child(6) { flex-basis: 100%; height: 0; margin: 0; overflow: hidden; font-size: 0; }
  }
</style>
