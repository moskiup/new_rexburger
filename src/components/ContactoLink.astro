---
import Icono from './Icono.astro';
import { telLink, waLink } from '../lib/contacto';

interface Props {
  tipo: 'whatsapp' | 'telefono';
  /** Número local con espacios, como en `sucursales` de config.ts. */
  numero: string;
  /** Color del icono: 'crema' sobre fondos rojos, 'rojo' sobre fondos claros. */
  tono?: 'crema' | 'rojo';
  /** Sin icono, solo el número. */
  icono?: boolean;
  class?: string;
  [atributo: string]: unknown;
}

const { tipo, numero, tono = 'crema', icono = true, class: clase, ...resto } = Astro.props;
const whatsapp = tipo === 'whatsapp';
---

<!-- {...resto} deja pasar el atributo de ámbito de los estilos de la página que lo usa -->
<a
  class:list={['contacto-link', clase]}
  data-tono={tono}
  href={whatsapp ? waLink(numero) : telLink(numero)}
  rel={whatsapp ? 'noopener' : undefined}
  data-tel={whatsapp ? undefined : telLink(numero)}
  {...resto}
>
  {icono && <Icono nombre={tipo} class="cl-ico" />}<span class="sr-only">{whatsapp ? 'WhatsApp ' : 'Teléfono '}</span>{numero}
</a>

<style>
  .contacto-link { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
  /* Ancho del icono: la página que lo usa puede cambiarlo con --cl-icono. El alto sale de la proporción del SVG. */
  .contacto-link :global(.cl-ico) { width: var(--cl-icono, 16px); height: auto; flex: none; color: #f0ece2; }
  .contacto-link[data-tono='rojo'] :global(.cl-ico) { color: var(--red); }
  /* Sin href (teléfonos en escritorio) es texto simple: no se subraya. */
  .contacto-link[href]:hover { text-decoration: underline; }
</style>

<script>
  /* Los teléfonos (tel:) solo son enlaces en móvil, donde se puede llamar. En escritorio se quita el href
     y quedan como texto simple (sin enlace, sin foco, sin subrayado). WhatsApp sigue siendo enlace. */
  const escritorio = matchMedia('(min-width: 768px)');
  const aplicar = () =>
    document.querySelectorAll<HTMLAnchorElement>('a.contacto-link[data-tel]').forEach((a) => {
      if (escritorio.matches) a.removeAttribute('href');
      else a.setAttribute('href', a.dataset.tel!);
    });
  aplicar();
  escritorio.addEventListener('change', aplicar);
</script>
