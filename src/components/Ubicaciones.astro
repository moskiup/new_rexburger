---
import { Image } from 'astro:assets';
import pin from '../assets/inicio/icono-ubicacion.webp';
import asterisco from '../assets/inicio/grafico-1-ubicaciones.webp';
import equis from '../assets/inicio/grafico-2-ubicaciones.webp';
import isotipo from '../assets/inicio/isotipo-mapa.webp';
import { sucursales } from '../data/config';
const palabra = 'REXQUISITO'.split('');
---

<section class="ubicaciones" aria-labelledby="ubic-title">
  <Image class="deco a" src={asterisco} alt="" width={56} />
  <Image class="deco b" src={equis} alt="" width={56} />
  <h2 id="ubic-title" class="frase" aria-label="El sabor Rexquisito, más cerca de ti">
    <span class="l1" aria-hidden="true">El sabor</span>
    <span class="l2" aria-hidden="true">{palabra.map((c, i) => <span class="wv" style={`--i:${i}`}>{c}</span>)}</span>
    <span class="pildora" aria-hidden="true">Más cerca de ti</span>
  </h2>
  <ul>
    {sucursales.map((s) => (
      <li>
        <Image src={pin} alt="" width={22} />
        <strong>{s.nombre}</strong>
        <a class="mas" href={`/sucursales#${s.slug}`}>Más<span class="sr-only"> información de {s.nombre}</span></a>
      </li>
    ))}
  </ul>
</section>

<div
  id="mapa"
  role="region"
  aria-label="Mapa de sucursales"
  data-sucursales={JSON.stringify(sucursales.map((s) => ({ n: s.nombre, d: s.direccion, c: s.coords, slug: s.slug })))}
  data-icon={isotipo.src}
></div>

<style>
  .ubicaciones {
    position: relative;
    background: var(--cream);
    padding: clamp(30px, 5vw, 70px) var(--gutter) clamp(30px, 5vw, 60px);
    display: grid;
    justify-items: center;
    gap: clamp(20px, 3vw, 40px);
    overflow: hidden;
  }
  /* Título en texto (antes era una imagen). Todo escala con el ancho del contenedor. */
  .frase {
    width: clamp(280px, 38vw, 480px);
    container-type: inline-size;
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: 400;
  }
  .l1 { font-size: 12cqw; line-height: 1; }
  .l2 {
    font-family: var(--font-fun);
    font-size: 17.5cqw;
    line-height: 1.05;
    white-space: nowrap;
    margin-top: 3cqw;
  }
  .wv {
    display: inline-block;
    transform-origin: 50% 85%;
    text-shadow: .09em .12em 0 #d8d8c8;
    animation: wave 1.8s cubic-bezier(.3, .6, .4, 1) 3 both paused;
    animation-delay: calc(var(--i) * .08s);
  }
  /* Ola con rebote: se agacha, salta estirándose y se inclina, y asienta con un pequeño rebote. */
  /* La ola corre 3 veces cada vez que el título entra en pantalla (la clase .on la pone el script). */
  .frase.on :global(.wv) { animation-play-state: running; }
  @keyframes wave {
    0%, 62%, 100% { transform: translateY(0) rotate(0) scale(1, 1); }
    12% { transform: translateY(.07em) rotate(0) scale(1.12, .88); }
    28% { transform: translateY(-.4em) rotate(-7deg) scale(.94, 1.12); }
    42% { transform: translateY(.04em) rotate(5deg) scale(1.06, .94); }
    52% { transform: translateY(-.07em) rotate(-2deg) scale(.99, 1.02); }
  }
  .pildora {
    margin-top: 5cqw;
    width: 100%;
    padding: 3.6cqw 0;
    border-radius: 999px;
    background: var(--orange);
    color: var(--cream);
    font-weight: 600;
    font-size: 6.3cqw;
    letter-spacing: .24em;
    text-indent: .24em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1;
  }
  .deco { position: absolute; width: clamp(24px, 4vw, 56px); height: auto; }
  .a { left: 6%; top: 18%; }
  .b { right: 8%; top: 22%; }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 1100px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    gap: 20px 12px;
  }
  li { display: grid; justify-items: center; gap: 10px; min-width: 110px; }
  li img { width: 18px; }
  strong { font-weight: 500; text-transform: uppercase; font-size: clamp(var(--fs-sm), 1.3vw, var(--fs-md)); }
  .mas {
    position: relative;
    background: var(--orange);
    color: var(--on-orange);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: 4px 16px;
    border-radius: 999px;
  }
  /* Área táctil mínima de 44px alrededor de la píldora. */
  .mas::after { content: ''; position: absolute; inset: -12px -8px; }
  .mas:hover { filter: brightness(1.08); }

  #mapa { height: clamp(300px, 45vw, 560px); background: #e6e6e6; z-index: 0; }
  #mapa.mapa-vacio { display: grid; place-items: center; color: var(--red); text-align: center; padding: 16px; }
  li img { animation: pop 2.4s ease-in-out infinite; }
  li:nth-child(2) img { animation-delay: .2s; } li:nth-child(3) img { animation-delay: .4s; }
  li:nth-child(4) img { animation-delay: .6s; } li:nth-child(5) img { animation-delay: .8s; }
  .a { animation: spin 14s linear infinite; }
  .b { animation: spin 18s linear infinite reverse; }
</style>

<script>
  const el = document.getElementById('mapa');
  const key = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;

  type Sucursal = { n: string; d: string; c: [number, number]; slug: string };

  function fallback(el: HTMLElement, msg: string) {
    el.textContent = msg;
    el.classList.add('mapa-vacio');
  }

  if (el) {
    if (!key) {
      fallback(el, 'Mapa no disponible: falta PUBLIC_GOOGLE_MAPS_API_KEY.');
    } else {
      const data: Sucursal[] = JSON.parse(el.dataset.sucursales || '[]');
      (window as any).__initMapa = () => {
        const g = (window as any).google.maps;
        const bounds = new g.LatLngBounds();
        const map = new g.Map(el, {
          center: { lat: data[0].c[0], lng: data[0].c[1] },
          zoom: 9,
          disableDefaultUI: true,
          zoomControl: true,
          gestureHandling: 'cooperative',
          styles: [
            { stylers: [{ saturation: -100 }, { lightness: 12 }] },
            { featureType: 'poi', stylers: [{ visibility: 'off' }] },
            { featureType: 'transit', stylers: [{ visibility: 'off' }] },
          ],
        });
        const info = new g.InfoWindow();
        data.forEach((s) => {
          const position = { lat: s.c[0], lng: s.c[1] };
          bounds.extend(position);
          const marker = new g.Marker({
            map,
            position,
            title: s.n,
            icon: { url: el.dataset.icon, scaledSize: new g.Size(36, 33), anchor: new g.Point(18, 33) },
          });
          marker.addListener('click', () => {
            info.setContent(
              `<div style="font-family:Outfit,sans-serif;color:#bc1417"><strong>${s.n}</strong><br>${s.d}<br>` +
                `<a style="color:#bc1417;font-weight:600" href="/sucursales#${s.slug}">Más información</a></div>`,
            );
            info.open({ map, anchor: marker });
          });
        });
        map.fitBounds(bounds, 48);
      };
      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&callback=__initMapa&loading=async`;
      script.async = true;
      script.onerror = () => fallback(el, 'No se pudo cargar el mapa.');
      document.head.appendChild(script);
    }
  }
</script>

<script>
  // Reinicia la ola de "REXQUISITO" cada vez que el título aparece: se repite 3 veces y se detiene.
  const frase = document.querySelector<HTMLElement>('.frase');
  if (frase && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      const visible = entries[0].isIntersecting;
      if (visible) {
        frase.classList.remove('on');
        void frase.offsetWidth; // reinicia las animaciones
        frase.classList.add('on');
      } else {
        frase.classList.remove('on');
      }
    }, { threshold: 0.5 }).observe(frase);
  } else if (frase) {
    frase.classList.add('on');
  }
</script>
