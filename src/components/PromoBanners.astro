---
import { Image } from 'astro:assets';
import fondoMerch from '../assets/inicio/fondo-merch.webp';
---

<section class="promo merch">
  <Image class="bg" src={fondoMerch} alt="Persona usando playera y gorra Rex Burger" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
  <h2>Descubre</h2>
  <p class="sub">nuestra merch</p>
  <a class="btn" href="/merch">Compra ahora</a>
</section>

<style>
  .promo {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
  }
  .bg { display: block; width: 100%; height: auto; }
  .promo > :not(.bg) { position: absolute; margin: 0; }
  .btn {
    display: grid;
    place-items: center;
    color: var(--red);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: max(12px, 2.4cqw);
    padding-right: 4cqw;
  }
  .btn:hover { filter: brightness(1.1); }

  .merch h2 {
    left: 51%; top: 24%;
    font-family: var(--font-display-light);
    font-weight: 400;
    font-size: 14cqw;
    line-height: 1;
    text-transform: uppercase;
  }
  .sub {
    left: 51%; top: 50%;
    font-size: 4.2cqw;
    line-height: 1;
    text-transform: uppercase;
  }
  /* El arte de merch ya no trae la píldora: se dibuja aquí, con su triángulo. */
  .merch .btn {
    left: 53.46%; width: 29.75%; top: 70.82%; height: 10.31%;
    background: linear-gradient(90deg, #d89918, #e2a113);
    border-radius: 999px;
    position: absolute;
    font-size: max(12px, 2cqw);
    letter-spacing: .1em;
    padding-right: 5cqw;
    color: #6a090c;
  }
  .merch .btn::after {
    content: '';
    position: absolute;
    right: 3.2cqw;
    top: 50%;
    translate: 0 -50%;
    border-left: 1.5cqw solid #6a090c;
    border-top: .85cqw solid transparent;
    border-bottom: .85cqw solid transparent;
  }

  /* ---------- Móvil: foto arriba y el texto debajo, con botón de ancho cómodo ---------- */
  @media (max-width: 767px) {
    .promo.merch { display: grid; justify-items: start; padding-bottom: 32px; background: var(--white); }
    .promo.merch > :not(.bg) { position: static; }
    .promo.merch > h2 { font-size: 15.5cqw; margin: 22px 22px 0; }
    .promo.merch > .sub { font-size: 7cqw; margin: 4px 22px 0; }
    .promo.merch > .btn {
      position: relative;
      left: auto;
      top: auto;
      width: min(calc(100% - 44px), 320px);
      height: 54px;
      margin: 22px 22px 0;
      font-size: 15px;
      padding-right: 14px;
    }
    .promo.merch > .btn::after { right: 22px; border-left-width: 9px; border-top-width: 5.5px; border-bottom-width: 5.5px; }
  }
  .merch .bg { transition: transform 1.2s ease; }
  @media (hover: hover) { .merch:hover .bg { transform: scale(1.03); } }
</style>
