---
import { Image } from 'astro:assets';
import fondoMerch from '../assets/inicio/fondo-merch.webp';
import BotonPildora from './BotonPildora.astro';
---

<section class="promo merch">
  <Image class="bg" src={fondoMerch} alt="Persona usando playera y gorra Rex Burger" widths={[800, 1600, 2400]} sizes="100vw" loading="eager" />
  <h2>Descubre</h2>
  <p class="sub">nuestra merch</p>
  <BotonPildora href="/merch" variante="ambar">Compra ahora</BotonPildora>
</section>

<style>
  .promo {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
  }
  .bg { display: block; width: 100%; height: auto; }
  .promo > :not(.bg) { position: absolute; margin: 0; }
  .merch h2 {
    left: 51%; top: 24%;
    font-family: var(--font-display-light);
    font-weight: 400;
    font-size: 14cqw;
    line-height: 1;
    text-transform: uppercase;
  }
  .sub {
    left: 51%; top: 50%;
    font-size: 4.2cqw;
    line-height: 1;
    text-transform: uppercase;
  }
  /* Posición del botón; su aspecto (píldora con triángulo) está en BotonPildora.astro. */
  .merch .btn { left: 53.46%; width: 29.75%; top: 70.82%; height: 10.31%; }

  /* ---------- Móvil: la foto cubre todo el banner y el texto va encima, sobre un degradado blanco ---------- */
  @media (max-width: 767px) {
    .promo.merch {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      min-height: 340px;
      padding: 0 22px 26px;
      background: var(--white);
    }
    .promo.merch > .bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 22% 0;
    }
    .promo.merch::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgb(255 255 255 / .96) 0%, rgb(255 255 255 / .86) 36%, rgb(255 255 255 / 0) 66%);
      pointer-events: none;
    }
    .promo.merch > :not(.bg) { position: relative; z-index: 1; }
    .promo.merch > h2 { left: auto; top: auto; font-size: 16cqw; line-height: .88; margin: 0; }
    .promo.merch > .sub { left: auto; top: auto; font-size: 6.6cqw; line-height: 1; margin: 2px 0 0; }
    .promo.merch > .btn { left: auto; top: auto; width: min(100%, 320px); height: 50px; margin: 12px 0 0; }
  }
  .merch .bg { transition: transform 1.2s ease; }
  @media (hover: hover) { .merch:hover .bg { transform: scale(1.03); } }
</style>
