---
import { Image } from 'astro:assets';
import ContactoLink from './ContactoLink.astro';
import redesImg from '../assets/inicio/redes.webp';
import domicilio from '../assets/inicio/servicio-a-domicilio.webp';
import { sucursales, redes } from '../data/config';

interface Props {
  titulo?: string;
}
const { titulo } = Astro.props;
---

<footer class="footer" id="contacto">
  {titulo && <h2>{titulo}</h2>}
  <ul class="branches">
    {sucursales.map((s) => (
      <li>
        <strong>{s.corto}</strong>
        <ContactoLink tipo="whatsapp" numero={s.whatsapp} />
        <ContactoLink tipo="telefono" numero={s.telefono} />
      </li>
    ))}
  </ul>
  <div class="bottom">
    <div class="social">
      <Image src={redesImg} alt="" width={96} />
      <a class="s1" href={redes.facebook} aria-label="Facebook"></a>
      <a class="s2" href={redes.instagram} aria-label="Instagram"></a>
      <a class="s3" href={redes.tiktok} aria-label="TikTok"></a>
    </div>
    <div class="domicilio">
      <Image src={domicilio} alt="Servicio a domicilio" width={170} />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--red);
    color: var(--yellow-text);
    padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(20px, 3vw, 32px);
  }
  h2 {
    color: var(--white);
    font-size: clamp(var(--fs-lg), 2.4vw, 28px);
    letter-spacing: .15em;
    margin-bottom: 20px;
  }
  .branches {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--maxw);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px 0;
  }
  .branches li {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 4px 8px;
    border-left: 1px solid rgb(251 181 0 / .6);
    font-size: clamp(var(--fs-xs), 1vw, var(--fs-sm));
  }
  .branches li:first-child { border-left: 0; }
  strong { color: var(--yellow-text); letter-spacing: .1em; text-transform: uppercase; font-weight: 600; }
  .branches a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--white);
  }
  .bottom {
    max-width: var(--maxw);
    margin: clamp(24px, 4vw, 44px) auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .social { position: relative; width: 96px; }
  .social a { position: absolute; top: 0; bottom: 0; width: 33%; }
  .s1 { left: 0; } .s2 { left: 33%; } .s3 { right: 0; }
  .domicilio img { width: clamp(120px, 14vw, 170px); }
  @media (max-width: 767px) {
    .footer { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
    h2 { font-size: 22px; }
    .branches a { min-height: var(--tap); font-size: var(--fs-md); }
    .social { width: 138px; }
    .social a { width: 33.3%; }
    .domicilio img { width: 150px; }
    .branches { grid-template-columns: repeat(2, 1fr); }
    .branches li { border-left: 0; padding: 8px; }
    .branches li:nth-child(odd) { border-right: 1px solid rgb(251 181 0 / .6); }
    .branches li:last-child { grid-column: 1 / -1; border-right: 0; }
    .branches li { font-size: var(--fs-sm); gap: 0; }
  }
</style>
