---
import { Image } from 'astro:assets';
import ContactoLink from './ContactoLink.astro';
import redesImg from '../assets/inicio/redes.webp';
import domicilio from '../assets/inicio/servicio-a-domicilio.webp';
import { sucursales, redes } from '../data/config';

interface Props {
  titulo?: string;
  /** Con `false` se oculta la fila de sucursales (por ejemplo en Contacto, que ya las muestra en tarjetas). */
  mostrarSucursales?: boolean;
}
const { titulo, mostrarSucursales = true } = Astro.props;
---

<footer class="footer" class:list={[{ 'sin-sucursales': !mostrarSucursales }]} id="contacto">
  {titulo && <h2>{titulo}</h2>}
  {mostrarSucursales && (
    <ul class="branches">
      {sucursales.map((s, i) => (
        <>
          {i > 0 && <li class="sep" role="presentation" aria-hidden="true" />}
          <li>
            <strong>{s.corto}</strong>
            <ContactoLink tipo="whatsapp" numero={s.whatsapp} />
            <ContactoLink tipo="telefono" numero={s.telefono} />
          </li>
        </>
      ))}
    </ul>
  )}
  <div class="bottom">
    <div class="social">
      <Image src={redesImg} alt="" widths={[110, 220, 330]} sizes="(max-width: 767px) 110px, 96px" quality={95} />
      {redes.facebook && <a class="s1" href={redes.facebook} aria-label="Facebook"></a>}
      {redes.instagram && <a class="s2" href={redes.instagram} aria-label="Instagram"></a>}
      {redes.tiktok && <a class="s3" href={redes.tiktok} aria-label="TikTok"></a>}
    </div>
    <div class="domicilio">
      <Image src={domicilio} alt="Servicio a domicilio" widths={[120, 170, 220, 330, 440, 660]} sizes="(max-width: 767px) 120px, 170px" quality={95} />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--red);
    color: var(--yellow-text);
    padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(20px, 3vw, 32px);
  }
  h2 {
    color: var(--white);
    font-size: clamp(var(--fs-lg), 2.4vw, 28px);
    letter-spacing: .15em;
    margin: 0 auto 20px;
    max-width: var(--maxw);
  }
  .branches {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--maxw);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px 0;
  }
  .branches li {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 4px 8px;
    border-left: 1px solid rgb(251 181 0 / .6);
    font-size: clamp(var(--fs-xs), 1vw, var(--fs-sm));
  }
  .branches li:first-child { border-left: 0; }
  /* Escritorio: el texto de cada sucursal arranca a la izquierda de su columna, de modo que "CONTACTOS",
     "SUC. ATOTONILCO" y los iconos de redes quedan alineados en el mismo borde. */
  @media (min-width: 768px) {
    /* Columnas del ancho de su contenido, repartidas de borde a borde: el último texto termina donde
       termina la fila, y ahí queda alineado "Servicio a domicilio". */
    /* Entre cada sucursal hay una columna flexible (li.sep) con la línea en su centro: queda siempre a la
       misma distancia del texto de la izquierda y del de la derecha. */
    .branches { grid-template-columns: auto repeat(4, 1fr auto); }
    .branches li { justify-items: start; text-align: left; padding: 4px 0; border-left: 0; }
    .branches li.sep { position: relative; padding: 0; }
    .branches li.sep::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgb(251 181 0 / .6); }
  }
  strong { color: #fbb500; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; }
  .branches a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--white);
  }
  .sin-sucursales .bottom { margin-top: 0; }
  .bottom {
    max-width: var(--maxw);
    margin: clamp(24px, 4vw, 44px) auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .social { position: relative; width: 96px; }
  .social a { position: absolute; top: 0; bottom: 0; width: 33%; }
  .s1 { left: 0; } .s2 { left: 33%; } .s3 { right: 0; }
  .domicilio img { width: clamp(120px, 14vw, 170px); }
  @media (max-width: 767px) {
    .footer { padding-bottom: calc(28px + env(safe-area-inset-bottom)); }
    h2 { font-size: 22px; text-align: center; padding-left: .15em; }
    .branches a { min-height: 26px; font-size: var(--fs-sm); --cl-icono: 14px; }
    .social { width: 110px; }
    .social a { width: 33.3%; }
    .domicilio img { width: 120px; }
    .branches { grid-template-columns: repeat(2, 1fr); }
    .branches li { border-left: 0; padding: 8px; }
    /* Capilla de GPE (4.ª; hijo 7 por los separadores) tiene el nombre más largo: pasa a la fila final, centrada, y Zapotlanejo ocupa su lugar. */
    .branches li.sep { display: none; }
    .branches li:nth-child(7) { order: 5; grid-column: 1 / -1; }
    .branches li:nth-child(9) { order: 4; grid-column: auto; }
    .branches strong { letter-spacing: .05em; white-space: nowrap; }
    .branches li { font-size: var(--fs-sm); gap: 0; }
  }
</style>
