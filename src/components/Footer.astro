---
import { Image } from 'astro:assets';
import tel from '../assets/inicio/telefono-icono.webp';
import wa from '../assets/inicio/whatsapp-icono.webp';
import redesImg from '../assets/inicio/redes.webp';
import domicilio from '../assets/inicio/servicio-a-domicilio.webp';
import { sucursales, redes, site } from '../data/config';

interface Props {
  titulo?: string;
}
const { titulo } = Astro.props;
---

<footer class="footer" id="contacto">
  {titulo && <h2>{titulo}</h2>}
  <ul class="branches">
    {sucursales.map((s) => (
      <li>
        <strong>{s.corto}</strong>
        <a href={`https://wa.me/${site.ladaPais}${s.whatsapp.replace(/\s/g, '')}`} rel="noopener">
          <Image src={wa} alt="WhatsApp" width={14} height={14} />{s.whatsapp}
        </a>
        <a href={`tel:+${site.ladaPais}${s.telefono.replace(/\s/g, '')}`}>
          <Image src={tel} alt="Teléfono" width={14} height={14} />{s.telefono}
        </a>
      </li>
    ))}
  </ul>
  <div class="bottom">
    <div class="social">
      <Image src={redesImg} alt="" width={96} />
      <a class="s1" href={redes.facebook} aria-label="Facebook"></a>
      <a class="s2" href={redes.instagram} aria-label="Instagram"></a>
      <a class="s3" href={redes.tiktok} aria-label="TikTok"></a>
    </div>
    <a href={redes.domicilio} class="domicilio">
      <Image src={domicilio} alt="Servicio a domicilio" width={170} />
    </a>
  </div>
</footer>

<style>
  .footer {
    background: var(--red);
    color: var(--yellow);
    padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(20px, 3vw, 32px);
  }
  h2 {
    color: var(--white);
    font-size: clamp(18px, 2.4vw, 28px);
    letter-spacing: .15em;
    margin-bottom: 20px;
  }
  .branches {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--maxw);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px 0;
  }
  .branches li {
    display: grid;
    gap: 4px;
    justify-items: center;
    text-align: center;
    padding: 4px 8px;
    border-left: 1px solid rgb(251 181 0 / .6);
    font-size: clamp(10px, 1vw, 13px);
  }
  .branches li:first-child { border-left: 0; }
  strong { letter-spacing: .1em; text-transform: uppercase; font-weight: 600; }
  .branches a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--white);
  }
  .branches a:hover { text-decoration: underline; }
  .bottom {
    max-width: var(--maxw);
    margin: clamp(24px, 4vw, 44px) auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .social { position: relative; width: 96px; }
  .social a { position: absolute; top: 0; bottom: 0; width: 33%; }
  .s1 { left: 0; } .s2 { left: 33%; } .s3 { right: 0; }
  .domicilio img { width: clamp(120px, 14vw, 170px); }
  @media (max-width: 860px) {
    .branches { grid-template-columns: repeat(2, 1fr); }
    .branches li { border-left: 0; padding: 8px; }
    .branches li:nth-child(odd) { border-right: 1px solid rgb(251 181 0 / .6); }
    .branches li:last-child { grid-column: 1 / -1; border-right: 0; }
    .branches li { font-size: 12px; }
  }
</style>
