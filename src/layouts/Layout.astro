---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { site } from '../data/config';

interface Props {
  title?: string;
  description?: string;
  footerTitle?: string;
}
const {
  title = site.titulo,
  description = site.descripcion,
  footerTitle,
} = Astro.props;

// Dirección absoluta de esta página y de la imagen para compartir (Astro.site viene de astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL(site.imagenCompartir, Astro.site).href;
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.colorTema} />
    <link rel="canonical" href={canonical} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Al compartir el enlace (WhatsApp, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hamburguesas Rex Burger California Style: ¡Haz tu día más rexquisito!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <link rel="preload" href="/fonts/outfit-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/super-plants.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <Loader />
    <Header />
    <main><slot /></main>
    <Footer titulo={footerTitle} />
    <script>
      import '../scripts/reveal';
      import '../scripts/animaciones';
    </script>
  </body>
</html>
