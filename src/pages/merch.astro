---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Cart from '../components/Cart.astro';
import { paginas } from '../data/contenido';
import tsOverWhite from '../assets/merch/t-shirt-oversize-white.webp';
import tsOverBlack from '../assets/merch/t-shirt-oversize-black.webp';
import hoodBlack from '../assets/merch/hoodie-black.webp';
import hoodGray from '../assets/merch/hoodie-gray.webp';
import tsKidsWhite from '../assets/merch/t-shirt-kids-white.webp';
import tsKidsBlack from '../assets/merch/t-shirt-kids-black.webp';
import gorraRed from '../assets/merch/gorra-red.webp';
import gorraBlack from '../assets/merch/gorra-black.webp';
import gorraCamo from '../assets/merch/gorra-camuflaje.webp';

const adulto = ['CH', 'M', 'GDE'];
const kids = ['4A', '6A', '8A'];
const productos = [
  { nombre: 'T-Shirt Oversize White', img: tsOverWhite, tallas: adulto },
  { nombre: 'T-Shirt Oversize Black', img: tsOverBlack, tallas: adulto },
  { nombre: 'Hoodie Black', img: hoodBlack, tallas: adulto },
  { nombre: 'Hoodie Gray', img: hoodGray, tallas: adulto },
  { nombre: 'T-Shirt Kids White', img: tsKidsWhite, tallas: kids },
  { nombre: 'T-Shirt Kids Black', img: tsKidsBlack, tallas: kids },
  { nombre: 'Gorra Red', img: gorraRed, tallas: ['Unitalla'] },
  { nombre: 'Gorra Black', img: gorraBlack, tallas: ['Unitalla'] },
  { nombre: 'Gorra Camuflaje', img: gorraCamo, tallas: ['Unitalla'] },
];
---

<Layout title={paginas.merch.titulo} description={paginas.merch.descripcion}>
  <h1 class="sr-only">{paginas.merch.h1}</h1>
  <ul class="grid">
    {productos.map((p, i) => (
      <li>
        <button type="button" class="card" data-producto data-nombre={p.nombre} data-tallas={p.tallas.join(',')}>
          <div class="foto">
            <Image class="prod" src={p.img} alt={p.nombre} widths={[400, 800]} sizes="(max-width: 767px) 45vw, 480px" loading={i < 2 ? 'eager' : 'lazy'} />
          </div>
          <h2>{p.nombre}</h2>
          <p>{p.tallas.join('  |  ')}</p>
        </button>
      </li>
    ))}
  </ul>
  <Cart />
</Layout>

<style>
  .grid {
    list-style: none;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 60px) var(--gutter) clamp(40px, 6vw, 80px);
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 5vw, 56px) clamp(14px, 3vw, 36px);
  }
  .card { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .foto {
    background: var(--cream);
    border-radius: clamp(14px, 2.4vw, 30px);
    aspect-ratio: 1 / 1.04;
    display: grid;
    place-items: center;
    padding: 6%;
  }
  .foto .prod { width: 100%; height: 100%; object-fit: contain; }
  h2 {
    margin-top: clamp(14px, 2.6vw, 30px);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  p {
    margin: 6px 0 0;
    color: #5c5c5c;
    font-size: clamp(var(--fs-xs), 1.2vw, var(--fs-sm));
    letter-spacing: .15em;
    white-space: pre;
    text-transform: uppercase;
  }
  .foto { transition: transform .35s ease, box-shadow .35s ease; }
  .foto .prod { transition: transform .45s ease; }
  @media (hover: hover) {
    li:hover .foto { transform: translateY(-6px); box-shadow: 0 14px 28px rgb(0 0 0 / .12); }
    li:hover .foto .prod { transform: scale(1.08); }
  }
  .card:active .foto { transform: scale(.97); }
  @media (max-width: 767px) {
    .grid { grid-template-columns: 1fr; gap: 34px; max-width: 460px; }
    .foto { aspect-ratio: 1 / .92; }
    h2 { font-size: var(--fs-md); margin-top: 14px; }
    p { font-size: var(--fs-sm); }
    h2 { letter-spacing: .08em; line-height: 1.25; }
    p { letter-spacing: .08em; }
  }
</style>
