---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import tel from '../assets/inicio/telefono-icono.webp';
import wa from '../assets/inicio/whatsapp-icono.webp';
import { sucursales, site } from '../data/config';
---

<Layout title="Contacto | Rex Burger" description="Teléfonos y WhatsApp de todas las sucursales Rex Burger.">
  <section class="contacto">
    <h1>Contactos</h1>
    <ul>
      {sucursales.map((s) => (
        <li>
          <h2>{s.corto}</h2>
          <p class="dir">{s.direccion}</p>
          <a href={`https://wa.me/${site.ladaPais}${s.whatsapp.replace(/\s/g, '')}`} rel="noopener">
            <Image src={wa} alt="WhatsApp" width={16} height={16} densities={[2, 3]} />{s.whatsapp}
          </a>
          <a href={`tel:+${site.ladaPais}${s.telefono.replace(/\s/g, '')}`}>
            <Image src={tel} alt="Teléfono" width={16} height={16} densities={[2, 3]} />{s.telefono}
          </a>
          <a class="mas" href={`/sucursales#${s.slug}`}>Ver sucursal</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .contacto { background: var(--cream); padding: clamp(32px, 6vw, 80px) var(--gutter); }
  h1 { font-family: var(--font-display-light); font-weight: 400; text-align: center; text-transform: uppercase; font-size: clamp(40px, 7vw, 90px); line-height: 1; }
  ul {
    list-style: none;
    margin: clamp(24px, 4vw, 56px) auto 0;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  li { background: var(--red); color: var(--white); border-radius: 24px; padding: 24px; display: grid; gap: 8px; justify-items: start; align-content: start; }
  h2 { color: var(--yellow-text); font-size: 15px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .dir { font-size: 14px; line-height: 1.4; margin-bottom: 4px; }
  li a { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; }
  li a:hover { text-decoration: underline; }
  .mas {
    margin-top: 8px;
    background: var(--orange);
    color: #6a090c;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .15em;
    text-transform: uppercase;
    padding: 12px 20px;
    border-radius: 999px;
  }
  li { transition: transform .3s ease, box-shadow .3s ease; }
  @media (hover: hover) { li:hover { transform: translateY(-6px); box-shadow: 0 14px 28px rgb(0 0 0 / .25); } }
</style>
