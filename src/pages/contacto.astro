---
import Layout from '../layouts/Layout.astro';
import ContactoLink from '../components/ContactoLink.astro';
import { sucursales } from '../data/config';
import { contacto, paginas } from '../data/contenido';
---

<Layout title={paginas.contacto.titulo} description={paginas.contacto.descripcion} footerSucursales={false}>
  <section class="contacto">
    <h1>{contacto.titulo}</h1>
    <ul>
      {sucursales.map((s) => (
        <li>
          <h2>{s.corto}</h2>
          <p class="dir">{s.direccion}</p>
          <ContactoLink tipo="whatsapp" numero={s.whatsapp} />
          <ContactoLink tipo="telefono" numero={s.telefono} />
          <a class="mas" href={`/sucursales#${s.slug}`}>{contacto.verSucursal}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .contacto { background: var(--cream); padding: clamp(32px, 6vw, 80px) var(--gutter); }
  h1 { font-family: var(--font-display-light); font-weight: 400; text-align: center; text-transform: uppercase; font-size: clamp(40px, 7vw, 90px); line-height: 1; }
  ul {
    list-style: none;
    margin: clamp(24px, 4vw, 56px) auto 0;
    padding: 0;
    max-width: 1100px;
    display: grid;
    grid-template-columns: 1fr;
    /* Separación entre tarjetas: crece con el ancho de la pantalla. */
    --gap: clamp(20px, 2.8vw, 40px);
    gap: var(--gap);
  }
  /* Escritorio: 3 tarjetas arriba y 2 abajo, centradas. */
  @media (min-width: 768px) {
    ul { display: flex; flex-wrap: wrap; justify-content: center; }
    li { flex: 0 0 calc((100% - 2 * var(--gap)) / 3); }
  }
  li { background: var(--red); color: var(--white); border-radius: 24px; padding: clamp(16px, 2.2vw, 24px); display: flex; flex-direction: column; align-items: center; gap: 8px; }
  h2 { text-align: center; color: #fbb500; font-size: 22px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-wrap: balance; }
  .dir { font-size: var(--fs-sm); line-height: 1.4; margin-bottom: 4px; text-align: center; text-wrap: balance; }
  li a { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-md); }
  li a[href]:not(.mas):hover { text-decoration: underline; }
  .mas:hover { text-decoration: none; }
  /* El botón baja siempre al fondo de la tarjeta: así queda a la misma altura en todas las de una fila,
     aunque la dirección de una ocupe dos líneas. */
  li .contacto-link:nth-last-child(2) { margin-bottom: 8px; }
  .mas {
    margin-top: auto;
    background: var(--orange);
    color: var(--on-orange);
    font-weight: 700;
    font-size: var(--fs-sm);
    /* El espaciado entre letras también se aplica tras la última, lo que corría el texto hacia la izquierda:
       se descuenta del relleno derecho para que el texto quede centrado en la píldora. */
    --mas-x: clamp(14px, 1.6vw, 20px);
    --mas-ls: clamp(.06em, .5vw, .15em);
    letter-spacing: var(--mas-ls);
    justify-content: center;
    text-transform: uppercase;
    padding: 12px calc(var(--mas-x) - var(--mas-ls)) 12px var(--mas-x);
    border-radius: 999px;
  }
  li { transition: transform .3s ease, box-shadow .3s ease; }
  @media (hover: hover) { li:hover { transform: translateY(-6px); box-shadow: 0 14px 28px rgb(0 0 0 / .25); } }
</style>
