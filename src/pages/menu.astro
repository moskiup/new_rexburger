---
import Layout from '../layouts/Layout.astro';
import Hamburguesas from '../components/menu/Hamburguesas.astro';
import Combos from '../components/menu/Combos.astro';
import Complementos from '../components/menu/Complementos.astro';
import Cajita from '../components/menu/Cajita.astro';
import Bebidas from '../components/menu/Bebidas.astro';
import Malteadas from '../components/menu/Malteadas.astro';
import '../styles/menu.css';
---

<Layout title="Menú | Rex Burger" description="Hamburguesas, combos, complementos, bebidas, malteadas y la Cajita Rexy Kids de Rex Burger California Style.">
  <h1 class="sr-only">Menú Rex Burger</h1>
  <Hamburguesas />
  <Combos />
  <Complementos />
  <Cajita />
  <Bebidas />
  <Malteadas />
</Layout>

<script>
  // Combos y Complementos: cada texto activa el zoom de su imagen y al revés; ambos crecen juntos.
  document.querySelectorAll<HTMLElement>('[data-zoom-par]').forEach((seccion) => {
    const imgs = seccion.querySelectorAll<HTMLElement>('[data-zoom-img]');
    const textos = seccion.querySelectorAll<HTMLElement>('[data-zoom-txt]');
    imgs.forEach((img, i) => {
      const t = textos[i];
      if (!t) return;
      const on = () => { img.classList.add('zoom'); t.classList.add('zoom'); };
      const off = () => { img.classList.remove('zoom'); t.classList.remove('zoom'); };
      [img, t].forEach((el) => {
        el.addEventListener('pointerenter', on);
        el.addEventListener('pointerleave', off);
      });
    });
  });
</script>
