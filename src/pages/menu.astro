---
import Layout from '../layouts/Layout.astro';
import Hamburguesas from '../components/menu/Hamburguesas.astro';
import Combos from '../components/menu/Combos.astro';
import Complementos from '../components/menu/Complementos.astro';
import Cajita from '../components/menu/Cajita.astro';
import Bebidas from '../components/menu/Bebidas.astro';
import Malteadas from '../components/menu/Malteadas.astro';
import '../styles/menu.css';
import { paginas } from '../data/contenido';
---

<Layout title={paginas.menu.titulo} description={paginas.menu.descripcion}>
  <h1 class="sr-only">Menú Rex Burger</h1>
  <Hamburguesas />
  <Combos />
  <Complementos />
  <Cajita />
  <Bebidas />
  <Malteadas />
</Layout>
