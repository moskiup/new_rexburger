---
import Layout from '../layouts/Layout.astro';
import EventosBanner from '../components/EventosBanner.astro';
import { sucursales, site } from '../data/config';
---

<Layout title="Eventos | Rex Burger" description="Llevamos Rex Burger a tus eventos: cumpleaños, bodas y reuniones en Atotonilco, La Barca, Arandas, Capilla de Guadalupe y Zapotlanejo.">
  <EventosBanner heading="h1" ctaLabel="Cotiza tu evento" ctaHref="/contacto" />

  <section class="info">
    <h2>Pide tu Rex donde quieras</h2>
    <p>Cumpleaños, bodas, empresas o reuniones: llevamos el sabor rexquisito a tu evento. Escríbele por WhatsApp a la sucursal más cercana para cotizar.</p>
    <ul>
      {sucursales.map((s) => (
        <li>
          <strong>{s.nombre}</strong>
          <a href={`https://wa.me/${site.ladaPais}${s.whatsapp.replace(/\s/g, '')}`} rel="noopener">{s.whatsapp}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .info { background: var(--cream); padding: clamp(32px, 6vw, 80px) var(--gutter); text-align: center; }
  h2 { font-family: var(--font-display-light); font-weight: 400; font-size: clamp(28px, 5vw, 60px); text-transform: uppercase; }
  .info > p { max-width: 640px; margin: 16px auto 0; font-size: clamp(var(--fs-sm), 1.8vw, var(--fs-lg)); line-height: 1.5; }
  ul { list-style: none; margin: clamp(24px, 4vw, 48px) auto 0; padding: 0; max-width: 900px; display: flex; flex-wrap: wrap; justify-content: center; gap: 20px 40px; }
  li { display: grid; gap: 4px; }
  strong { text-transform: uppercase; letter-spacing: .12em; font-weight: 600; font-size: var(--fs-sm); }
  li a:hover { text-decoration: underline; }
  @media (max-width: 767px) {
    .info { padding: 40px 22px 48px; }
    h2 { font-size: clamp(50px, 15.5vw, 68px); line-height: .95; letter-spacing: .02em; text-wrap: balance; }
    .info > p { font-size: var(--fs-lg); line-height: 1.55; margin-top: 18px; }
    ul { gap: 26px 20px; margin-top: 30px; }
    li { gap: 6px; min-width: 130px; }
    strong { font-size: var(--fs-md); }
    li a { font-size: var(--fs-xl); font-weight: 600; min-height: var(--tap); display: inline-flex; align-items: center; justify-content: center; }
  }
</style>
