---
import Layout from '../layouts/Layout.astro';
import EventosBanner from '../components/EventosBanner.astro';
import { bannerEventos, eventos, paginas } from '../data/contenido';
---

<Layout title={paginas.eventos.titulo} description={paginas.eventos.descripcion}>
  <EventosBanner heading="h1" ctaLabel={bannerEventos.botonContacto} ctaHref="/contacto" />

  <section class="info">
    <h2>{eventos.titulo}</h2>
    <p>{eventos.texto}</p>
  </section>
</Layout>

<style>
  .info { background: var(--cream); padding: clamp(32px, 6vw, 80px) var(--gutter); text-align: center; }
  h2 { font-family: var(--font-display-light); font-weight: 400; font-size: clamp(40px, 6.5vw, 88px); line-height: 1; text-transform: uppercase; }
  .info > p { max-width: 900px; margin: 20px auto 0; font-size: clamp(var(--fs-lg), 2.2vw, 30px); line-height: 1.45; }
  @media (max-width: 767px) {
    .info { padding: 40px 22px 48px; }
    h2 { font-size: clamp(56px, 18vw, 84px); line-height: .95; letter-spacing: .02em; text-wrap: balance; }
    .info > p { font-size: var(--fs-xl); line-height: 1.5; margin-top: 18px; }
  }
</style>
