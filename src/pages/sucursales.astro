---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import tel from '../assets/sucursales/telefono-icono.webp';
import wa from '../assets/sucursales/whatsapp-icono.webp';
import { sucursales, site } from '../data/config';

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/sucursales/sucursal-*-[123].png', { eager: true });
const slugFoto: Record<string, string> = {
  atotonilco: 'atoto',
  arandas: 'arandas',
  'la-barca': 'barca',
  'capilla-de-gpe': 'capilla',
  zapotlanejo: 'zapo',
};
/* Ajuste vertical del recorte para fotos cuyo sujeto no está al centro. */
const posicion: Record<string, string> = { 'atotonilco-2': '50% 72%' };
const fotosDe = (slug: string) =>
  [1, 2, 3].map((n) => fotos[`../assets/sucursales/sucursal-${slugFoto[slug]}-${n}.png`].default);
---

<Layout title="Sucursales | Rex Burger" description="Encuentra tu sucursal Rex Burger: Atotonilco, Arandas, La Barca, Capilla de Guadalupe y Zapotlanejo.">
  <h1 class="sr-only">Sucursales Rex Burger</h1>
  <div class="wrap">
    {sucursales.map((s, i) => (
      <section id={s.slug}>
        <h2>{s.nombre}</h2>
        <div class="fotos" data-swap={s.slug === 'la-barca' || s.slug === 'zapotlanejo' ? '' : undefined}>
          {fotosDe(s.slug).map((f, n) => (
            <Image src={f} style={posicion[`${s.slug}-${n + 1}`] ? `object-position:${posicion[`${s.slug}-${n + 1}`]}` : undefined} alt={`Sucursal ${s.nombre}, foto ${n + 1}`} widths={[400, 800]} sizes="(max-width: 767px) 50vw, 360px" loading={i === 0 ? 'eager' : 'lazy'} />
          ))}
        </div>
        <p class="dir">{s.direccion}</p>
        <p class="tels">
          <a href={`https://wa.me/${site.ladaPais}${s.whatsapp.replace(/\s/g, '')}`} rel="noopener">
            <Image src={wa} alt="WhatsApp" width={16} height={16} densities={[2, 3]} />{s.whatsapp}
          </a>
          <a href={`tel:+${site.ladaPais}${s.telefono.replace(/\s/g, '')}`}>
            <Image src={tel} alt="Teléfono" width={16} height={16} densities={[2, 3]} />{s.telefono}
          </a>
        </p>
      </section>
    ))}
  </div>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 var(--gutter) clamp(30px, 5vw, 70px); }
  section { scroll-margin-top: 8px; }
  h2 {
    font-family: var(--font-display-light);
    font-weight: 400;
    text-transform: uppercase;
    text-align: center;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1;
    padding: clamp(16px, 3vw, 36px) 0 clamp(10px, 1.6vw, 20px);
  }
  .fotos { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(8px, 1.6vw, 20px); }
  .fotos img {
    width: 100%;
    aspect-ratio: 1 / 1.12;
    height: 100%;
    object-fit: cover;
    border: 2px solid var(--red);
    border-radius: clamp(14px, 2.2vw, 28px);
  }
  .dir { font-size: clamp(var(--fs-md), 1.9vw, var(--fs-xl)); margin-top: clamp(14px, 2.4vw, 28px); }
  .tels { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 2px; font-size: clamp(var(--fs-sm), 1.4vw, var(--fs-md)); }
  .tels a { display: inline-flex; align-items: center; gap: 8px; min-height: var(--tap); }
  .tels a:hover { text-decoration: underline; }
  @media (max-width: 767px) {
    section { padding-bottom: 14px; }
    h2 { font-size: clamp(56px, 17vw, 72px); line-height: .95; letter-spacing: .02em; padding: 30px 0 14px; }
    .dir { font-size: var(--fs-xl); font-weight: 500; line-height: 1.35; margin-top: 18px; text-align: center; text-wrap: balance; }
    .tels { margin-top: 4px; gap: 0 26px; justify-content: center; }
    .tels a { font-size: var(--fs-lg); font-weight: 600; }
    .tels a img { width: 20px; height: 20px; }
  }
  @media (max-width: 767px) {
    .fotos { grid-template-columns: 1fr 1fr; gap: 8px; }
    .fotos img { aspect-ratio: 5 / 4; }
    .fotos img:nth-child(3) { grid-column: 2; grid-row: 1 / 3; aspect-ratio: auto; }
    .fotos img:nth-child(2) { grid-column: 1; grid-row: 2; }
    .fotos[data-swap] img:nth-child(2) { grid-column: 2; grid-row: 1 / 3; aspect-ratio: auto; }
    .fotos[data-swap] img:nth-child(3) { grid-column: 1; grid-row: 2; aspect-ratio: 5 / 4; }
  }
  .fotos { overflow: visible; }
  .fotos img { transition: transform .4s ease, box-shadow .4s ease; }
  @media (hover: hover) { .fotos img:hover { transform: scale(1.03); box-shadow: 0 12px 26px rgb(0 0 0 / .2); position: relative; z-index: 1; } }
</style>
