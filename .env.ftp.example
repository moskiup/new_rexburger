# Copia este archivo a .env.ftp y completa la contraseña. .env.ftp está ignorado por git: nunca lo subas ni lo pegues en chats.
# Solo el nombre del servidor (sin ftp://). Mejor el nombre que la IP: con la IP el certificado TLS no coincide.
FTP_SERVER=ftp.rexburger.com.mx
FTP_USERNAME=u420678263.uploader
FTP_PASSWORD=
# La cuenta FTP ya entra dentro de public_html/new, así que la carpeta es la raíz.
FTP_SERVER_DIR=/
# ftps (recomendado) o ftp
FTP_PROTOCOL=ftp
FTP_PORT=21
# Pon false solo si el servidor se queja del certificado TLS
FTP_TLS_ESTRICTO=false
