# Copia este archivo a .env y completa los valores. Las variables PUBLIC_ viajan al navegador.
PUBLIC_GOOGLE_MAPS_API_KEY=
# Número que recibe los pedidos del carrito: formato internacional, sin + ni espacios (ej. 523911255845)
PUBLIC_WHATSAPP_PEDIDOS=
PUBLIC_FACEBOOK_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_TIKTOK_URL=
# "true" para que los buscadores no indexen este sitio (pruebas y subdominios)
PUBLIC_NOINDEX=
